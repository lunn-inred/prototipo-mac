# Modelo para desenvolvimento local. Copie como `.streamlit/secrets.toml` e
# substitua os valores.
# Nunca adicione `.streamlit/secrets.toml` ao Git.

SUPABASE_DB_HOST = "aws-0-REGIAO.pooler.supabase.com"
SUPABASE_DB_PORT = "5432"
SUPABASE_DB_NAME = "postgres"
SUPABASE_DB_USER = "postgres.SEU_PROJECT_REF"
SUPABASE_DB_PASSWORD = "coloque_sua_senha_aqui"
SUPABASE_DB_SSLMODE = "require"

# Chave usada pelo OCR principal dos documentos legados de termografia.
LLAMA_CLOUD_API_KEY = "llx-coloque_sua_chave_aqui"

# Quando a API estiver em outro processo/servidor, configure estas duas chaves
# no ambiente do Streamlit. Sem MAC_API_BASE_URL, o modo local é utilizado.
# MAC_API_BASE_URL = "http://127.0.0.1:8000"
# MAC_API_KEY = "troque-por-uma-chave-forte"

# Configuração do processo da API.
# MAC_API_CORS_ORIGINS = "https://seu-frontend.example"
# MAC_API_TIMEOUT_SECONDS = "300"
