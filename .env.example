# Banco PostgreSQL/Supabase (processo da API)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# Integração opcional para documentos legados
LLAMA_CLOUD_API_KEY=

# Proteção e acesso à API. No desktop, esta chave é compartilhada internamente.
MAC_API_KEY=mac-local-dev-7f2c9a41d8e64b30b53f
MAC_API_CORS_ORIGINS=http://localhost:8501
MAC_API_TIMEOUT_SECONDS=300

# Usado somente quando API e Streamlit são iniciados separadamente.
# O launcher desktop substitui esta URL pela porta local escolhida automaticamente.
MAC_API_BASE_URL=http://127.0.0.1:8000
