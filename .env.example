# Aplicação: desenvolvimento usa exclusivamente PostgreSQL local.
MAC_ENVIRONMENT=development # development ou production
MAC_DB_TARGET=local # local ou supabase
MAC_LOCAL_DB_HOST=127.0.0.1
MAC_LOCAL_DB_PORT=55433
MAC_LOCAL_DB_NAME=mac_dev
MAC_LOCAL_DB_USER=mac_dev
MAC_LOCAL_DB_PASSWORD=mac_dev_local

# Supabase: origem de exportação explícita. Ignorado pela aplicação em modo local.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# Integração opcional para documentos legados
LLAMA_CLOUD_API_KEY=

# Proteção e acesso à API. No desktop, esta chave é compartilhada internamente.
MAC_API_KEY=mac-local-dev-7f2c9a41d8e64b30b53f
MAC_API_CORS_ORIGINS=http://localhost:8501
MAC_API_TIMEOUT_SECONDS=300

# Usado pelo modo web separado e por `python desktop.py`.
# O executável empacotado substitui esta URL pela porta local escolhida automaticamente.
MAC_API_BASE_URL=http://127.0.0.1:8000

# Login Google e pasta de backup no Drive (teste no próprio computador).
# Configure os valores reais somente no .env local. O e-mail restringe o acesso.
MAC_GOOGLE_CLIENT_ID=
MAC_GOOGLE_CLIENT_SECRET=
MAC_GOOGLE_ALLOWED_EMAIL=
# Login Google e pasta de backup no Drive
# Copie somente o ID em drive.google.com/drive/folders/ID.
MAC_GOOGLE_BACKUP_FOLDER_ID=
MAC_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
MAC_GOOGLE_FRONTEND_URL=http://localhost:8501
MAC_GOOGLE_PUBLIC_API_URL=http://localhost:8000

# Opcional no desenvolvimento; necessário para o executável desktop com API em porta variável.
# Crie um segundo cliente OAuth do tipo Desktop app no mesmo projeto Google.
MAC_GOOGLE_DESKTOP_CLIENT_ID=
MAC_GOOGLE_DESKTOP_CLIENT_SECRET=

# Análises térmicas locais (relativo à raiz do projeto ou ao diretório do binário)
MAC_ANALYSES_DIR=./data/thermography

# Cópias completas locais e cópias preventivas antes de restaurar (não versionar).
MAC_BACKUPS_DIR=./data/backups
# Limites de segurança: 10 GiB compactados e 20 GiB descompactados.
MAC_BACKUP_MAX_BYTES=10737418240
MAC_BACKUP_MAX_EXTRACTED_BYTES=21474836480
